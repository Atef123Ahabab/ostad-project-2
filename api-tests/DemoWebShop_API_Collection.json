{
  "info": {
    "_postman_id": "demo-webshop-api-collection",
    "name": "DemoWebShop_API",
    "description": "API automation for JSONPlaceholder users endpoint",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET All Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is a non-empty array', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "    pm.expect(jsonData.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test('Response contains user information', function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.be.greaterThan(0);",
              "    pm.expect(jsonData[0]).to.be.an('object');",
              "});",
              "",
              "pm.test('Each user has id, name, and email', function () {",
              "    const jsonData = pm.response.json();",
              "    jsonData.forEach(user => {",
              "        pm.expect(user).to.have.property('id');",
              "        pm.expect(user).to.have.property('name');",
              "        pm.expect(user).to.have.property('email');",
              "    });",
              "});",
              "",
              "const firstUser = pm.response.json()[0];",
              "pm.environment.set('userId', firstUser.id);",
              "pm.environment.set('userPhone', firstUser.phone);",
              "console.log('Saved userId:', firstUser.id, '| phone:', firstUser.phone);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        }
      }
    },
    {
      "name": "PUT Update User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const responseJson = pm.response.json();",
              "const savedId = pm.environment.get('userId');",
              "const sentBody = JSON.parse(pm.request.body.raw);",
              "",
              "pm.test('Returned ID matches saved userId', function () {",
              "    pm.expect(responseJson.id).to.eql(parseInt(savedId));",
              "});",
              "",
              "pm.test('Phone should not be empty', function () {",
              "    pm.expect(responseJson.phone).to.not.be.undefined;",
              "    pm.expect(responseJson.phone).to.not.be.empty;",
              "});",
              "",
              "pm.test('Returned name matches updated name', function () {",
              "    pm.expect(responseJson.name).to.eql(sentBody.name);",
              "});",
              "",
              "pm.test('Returned email matches updated email', function () {",
              "    pm.expect(responseJson.email).to.eql(sentBody.email);",
              "});",
              "",
              "pm.test('Company name matches updated value', function () {",
              "    pm.expect(responseJson.company.name).to.eql(sentBody.company.name);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Updated Name {{$randomFullName}}\",\n    \"email\": \"updated{{$randomInt}}@test.com\",\n    \"phone\": \"{{userPhone}}\",\n    \"company\": {\n        \"name\": \"Updated Company {{$randomCompanyName}}\"\n    }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["users", "{{userId}}"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ]
}
